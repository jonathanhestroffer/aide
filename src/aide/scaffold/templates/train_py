from __future__ import annotations

import argparse
import subprocess
import sys

from aide.core.environment import get_config_path


def main() -> None:

    parser = argparse.ArgumentParser(description="Run AIDE training script with .env config")
    parser.add_argument("--experiment", type=str, default="default", help="Experiment name to run")

    args = parser.parse_args()

    config_path = get_config_path(".env")

    command = [
        sys.executable,
        "-m",
        "aide.scripts.train",
        f"--config-path={config_path}",
        f"--config-name=experiment/{args.experiment}",
    ]

    print(f"Running: {' '.join(command)}")

    subprocess.run(command, check=True)


if __name__ == "__main__":
    main()
